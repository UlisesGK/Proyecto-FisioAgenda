@startuml
skinparam dpi 130
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0F766E
  HeaderBackgroundColor #D9EEF0
  ArrowColor #475569
}
skinparam package {
  BorderColor #94A3B8
  FontColor #0F3B5C
}
hide empty members
title Diagrama de clases de FisioAgenda (simplificado)

package "ui" {
  class MainFrame {
    - contenido : AnimatedCardPanel
    + MainFrame(usuario : Usuario)
    - mostrarSeccion(nombre : String)
    - ajustarSidebar()
  }
  abstract class Seccion <<JPanel>> {
    + refrescar()
  }
  class AgendaPanel
  class PacientesPanel
  class AnimatedCardPanel {
    + agregar(nombre : String, c : Component)
    + mostrar(nombre : String)
  }
}

package "service" {
  class ServiceLocator <<static>> {
    + auth() : AuthService
    + pacientes() : PacienteService
    + citas() : CitaService
    + historial() : HistorialService
  }
  class AuthService {
    + login(username : String, password : char[]) : Usuario
    + logout()
    + cambiarPassword(actual, nueva, repetida : char[])
  }
  class CitaService {
    + citasDelDia(dia : LocalDate, fisioId : Integer) : List<Cita>
    + guardar(c : Cita) : Cita
    + cambiarEstado(citaId : int, nuevo : EstadoCita)
    + huecosLibres(dia : LocalDate, fisioId : int, durMin : int) : List<LocalTime>
  }
  class PacienteService {
    + buscar(texto : String) : List<Paciente>
    + guardar(p : Paciente) : Paciente
    + eliminar(id : int)
  }
  class HistorialService {
    + notasDe(pacienteId : int) : List<NotaClinica>
    + anadirNota(pacienteId : int, citaId : Integer, contenido : String, eva : int) : NotaClinica
  }
}

package "security" {
  class Sesion <<singleton>> {
    + getInstance() : Sesion
    + iniciar(u : Usuario)
    + tieneRol(roles : Rol...) : boolean
  }
  class PasswordHasher <<static>> {
    + ITERACIONES = 600000
    + generarSal() : String
    + hash(pw : char[], sal : String) : String
    + verificar(pw : char[], sal : String, hash : String) : boolean
  }
}

package "dao" {
  interface CitaDAO {
    + listarPorDia(dia : LocalDate, fisioId : Integer) : List<Cita>
    + insertar(c : Cita) : Cita
    + actualizarEstado(id : int, e : EstadoCita)
  }
  interface PacienteDAO {
    + buscar(texto : String) : List<Paciente>
    + insertar(p : Paciente) : Paciente
  }
  interface UsuarioDAO {
    + buscarPorUsername(u : String) : Optional<Usuario>
    + actualizarControlAcceso(u : Usuario)
  }
}

package "dao.sqlite" {
  class SqliteCitaDAO
  class SqlitePacienteDAO
  class SqliteUsuarioDAO
}

package "db" {
  class Database <<singleton>> {
    + getInstance() : Database
    + getConexion() : Connection
  }
}

package "model" {
  class Usuario {
    - username : String
    - nombreCompleto : String
    - rol : Rol
    - intentosFallidos : int
    - bloqueadoHasta : LocalDateTime
    + estaBloqueado(ahora : LocalDateTime) : boolean
  }
  class Paciente {
    - dni : String
    - nombre : String
    - apellidos : String
    - fechaNacimiento : LocalDate
  }
  class Tratamiento {
    - nombre : String
    - duracionMinutos : int
    - precio : double
  }
  class Cita {
    - fechaHora : LocalDateTime
    - estado : EstadoCita
    + getFechaHoraFin() : LocalDateTime
    + seSolapaCon(otra : Cita) : boolean
  }
  class NotaClinica {
    - fecha : LocalDateTime
    - contenido : String
    - escalaDolor : int
  }
  enum Rol {
    ADMIN
    FISIOTERAPEUTA
    RECEPCION
  }
  enum EstadoCita {
    PROGRAMADA
    REALIZADA
    CANCELADA
    NO_ASISTIDA
  }
}

MainFrame *-- AnimatedCardPanel
MainFrame o-- "5" Seccion
Seccion <|-- AgendaPanel
Seccion <|-- PacientesPanel
AgendaPanel ..> ServiceLocator
PacientesPanel ..> ServiceLocator
ServiceLocator --> AuthService
ServiceLocator --> CitaService
ServiceLocator --> PacienteService
ServiceLocator --> HistorialService
AuthService --> UsuarioDAO
AuthService ..> PasswordHasher
AuthService ..> Sesion
CitaService --> CitaDAO
CitaService ..> Sesion
PacienteService --> PacienteDAO
HistorialService --> CitaDAO
CitaDAO <|.. SqliteCitaDAO
PacienteDAO <|.. SqlitePacienteDAO
UsuarioDAO <|.. SqliteUsuarioDAO
SqliteCitaDAO --> Database
SqlitePacienteDAO --> Database
SqliteUsuarioDAO --> Database
Cita "*" --> "1" Paciente
Cita "*" --> "1" Usuario : fisioterapeuta
Cita "*" --> "1" Tratamiento
Cita --> EstadoCita
Usuario --> Rol
NotaClinica "*" --> "1" Usuario : autor
NotaClinica "*" ..> "0..1" Cita
Database -[hidden]down-> Cita
@enduml
